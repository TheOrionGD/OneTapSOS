<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_primary"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 SOS ACTIVATION"
        android:textColor="@color/sos_red_solid"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Sending emergency alert in"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <!-- Big Countdown Digit -->
    <TextView
        android:id="@+id/tvCountdownNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="32dp"
        android:text="5"
        android:textColor="@color/white"
        android:textSize="100sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvRecipientInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alert will be sent via SMS &amp; GPS Location"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- CANCEL Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnCancelCountdown"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="❌  CANCEL SOS"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

</LinearLayout>
