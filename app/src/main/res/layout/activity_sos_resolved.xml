<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark_primary"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Green Success Badge -->
    <TextView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_pill_accent"
        android:gravity="center"
        android:text="✅"
        android:textSize="40sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="EMERGENCY RESOLVED"
        android:textColor="@color/success_green"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Your trusted contacts have been notified that you are safe."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Summary Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="28dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="Resolution Time:"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvResolutionTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:52 AM"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="Emergency Duration:"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7 mins 30 secs"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="Contacts Notified:"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvResolvedRecipients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 Contacts"
                android:textColor="@color/accent_teal"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Return to Dashboard"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

</LinearLayout>
