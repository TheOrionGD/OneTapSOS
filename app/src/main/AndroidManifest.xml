<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BIND_QUICK_SETTINGS_TILE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".SOSApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SOSense">

        <!-- 1. Splash Screen -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Onboarding Screen -->
        <activity android:name=".OnboardingActivity" android:exported="false" />
        <activity android:name=".OnboardingPermissionsActivity" android:exported="false" />

        <!-- 3. Safety Dashboard (Main Hub) & MainActivity -->
        <activity android:name=".MainActivity" android:exported="false" />
        <activity android:name=".SafetyDashboardActivity" android:exported="false" />

        <!-- 4. SOS Core Screens -->
        <activity android:name=".SOSActivationActivity" android:exported="false" />
        <activity android:name=".SOSCountdownActivity" android:exported="false" />
        <activity android:name=".SOSActiveActivity" android:exported="false" />
        <activity android:name=".SOSResolvedActivity" android:exported="false" />
        <activity android:name=".SOSDetailsActivity" android:exported="false" />
        <activity android:name=".SOSHistoryActivity" android:exported="false" />
        <activity android:name=".SOSDiagnosticsActivity" android:exported="false" />

        <!-- 5. Emergency Communication Screens -->
        <activity android:name=".EmergencyMessagesActivity" android:exported="false" />
        <activity android:name=".MessageTemplateActivity" android:exported="false" />
        <activity android:name=".ImSafeMessageActivity" android:exported="false" />
        <activity android:name=".EmergencyBroadcastActivity" android:exported="false" />
        <activity android:name=".MessageHistoryActivity" android:exported="false" />
        <activity android:name=".ConversationActivity" android:exported="false" />
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 6. Contacts Management Screens -->
        <activity android:name=".ContactsActivity" android:exported="false" />
        <activity android:name=".TrustedContactsActivity" android:exported="false" />
        <activity android:name=".AddTrustedContactActivity" android:exported="false" />
        <activity android:name=".EditTrustedContactActivity" android:exported="false" />
        <activity android:name=".ContactDetailActivity" android:exported="false" />
        <activity android:name=".GroupsActivity" android:exported="false" />
        <activity android:name=".ContactSelectionActivity" android:exported="false" />
        <activity android:name=".ContactPermissionActivity" android:exported="false" />

        <!-- 7. Location & Maps Screens (OpenStreetMap osmdroid) -->
        <activity android:name=".MapActivity" android:exported="false" />
        <activity android:name=".SafeMapActivity" android:exported="false" />
        <activity android:name=".SafeRouteActivity" android:exported="false" />
        <activity android:name=".NearbyHelpActivity" android:exported="false" />
        <activity android:name=".LocationDashboardActivity" android:exported="false" />
        <activity android:name=".LiveTrackingActivity" android:exported="false" />
        <activity android:name=".LocationHistoryActivity" android:exported="false" />
        <activity android:name=".LocationSharingSettingsActivity" android:exported="false" />
        <activity android:name=".LocationShareActiveActivity" android:exported="false" />
        <activity android:name=".LocationPermissionActivity" android:exported="false" />
        <activity android:name=".MapSettingsActivity" android:exported="false" />
        <activity android:name=".ShareLocationActivity" android:exported="false" />

        <!-- 8. Safety & Monitoring Screens -->
        <activity android:name=".CheckInActivity" android:exported="false" />
        <activity android:name=".SafetyCheckInHistoryActivity" android:exported="false" />
        <activity android:name=".SafetyTimerActivity" android:exported="false" />
        <activity android:name=".SafetyTimerActiveActivity" android:exported="false" />
        <activity android:name=".JourneyModeActivity" android:exported="false" />
        <activity android:name=".UnsafeSituationActivity" android:exported="false" />
        <activity android:name=".IncidentReportActivity" android:exported="false" />
        <activity android:name=".IncidentHistoryActivity" android:exported="false" />

        <!-- 9. Awareness & Guidance Screens -->
        <activity android:name=".SafetyTipsActivity" android:exported="false" />
        <activity android:name=".EmergencyNumbersActivity" android:exported="false" />
        <activity android:name=".DisasterGuideActivity" android:exported="false" />
        <activity android:name=".FirstAidActivity" android:exported="false" />
        <activity android:name=".EmergencyPreparationActivity" android:exported="false" />

        <!-- 10. Device & Battery Safety -->
        <activity android:name=".BatterySafetyActivity" android:exported="false" />
        <activity android:name=".BatteryAlertSettingsActivity" android:exported="false" />

        <!-- 11. Profile & Settings Screens -->
        <activity android:name=".ProfileActivity" android:exported="false" />
        <activity android:name=".EmergencyCardActivity" android:exported="false" />
        <activity android:name=".SOSSettingsActivity" android:exported="false" />
        <activity android:name=".NotificationSettingsActivity" android:exported="false" />
        <activity android:name=".LanguageSettingsActivity" android:exported="false" />
        <activity android:name=".PrivacySettingsActivity" android:exported="false" />
        <activity android:name=".PermissionsActivity" android:exported="false" />
        <activity android:name=".DataManagementActivity" android:exported="false" />
        <activity android:name=".AppearanceSettingsActivity" android:exported="false" />
        <activity android:name=".AppLockActivity" android:exported="false" />
        <activity android:name=".HelpAndSupportActivity" android:exported="false" />

        <!-- 12. Utilities -->
        <activity android:name=".FakeCallActivity" android:exported="false" />
        <activity android:name=".PanicWidgetActivity" android:exported="false" />

        <!-- Services & Receivers -->
        <service
            android:name=".SOSForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".SOSTileService"
            android:icon="@android:drawable/ic_dialog_alert"
            android:label="Send SOS"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".FallDetectionService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".SOSReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sosence.app.SEND_SOS" />
                <action android:name="com.sosence.app.CANCEL_SOS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".FallCancelReceiver"
            android:exported="false" />

        <receiver
            android:name=".SOSNotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sosence.app.ACTION_RESOLVE_SOS" />
                <action android:name="com.sosence.app.ACTION_CANCEL_FALL" />
                <action android:name="com.sosence.app.ACTION_CONFIRM_CHECK_IN" />
                <action android:name="com.sosence.app.ACTION_EXTEND_TIMER" />
                <action android:name="com.sosence.app.ACTION_STOP_JOURNEY" />
                <action android:name="com.sosence.app.ACTION_TRIGGER_INSTANT_SOS" />
                <action android:name="com.sosence.app.ACTION_ANSWER_FAKE_CALL" />
                <action android:name="com.sosence.app.ACTION_DECLINE_FAKE_CALL" />
                <action android:name="com.sosence.app.ACTION_SEND_BATTERY_SMS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>